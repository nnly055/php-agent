#!/usr/bin/env php
<?php

declare(strict_types=1);

/**
 * PHP Agent 终端入口。
 *
 *   php bin/agent          正常启动（按 .env 的 provider 与插件装配）
 *   php bin/agent --fake   离线演示（不需要 API key）
 */

use PhpAgent\Agent\AgentLoop;
use PhpAgent\Agent\DefaultSystemPrompt;
use PhpAgent\Command\CommandContext;
use PhpAgent\Config;
use PhpAgent\Hook\ConfirmHook;
use PhpAgent\Hook\HookPipeline;
use PhpAgent\Kernel\AgentKernel;
use PhpAgent\Kernel\PluginManager;
use PhpAgent\Ui\ConsoleUi;

require __DIR__ . '/../vendor/autoload.php';

$root = dirname(__DIR__);
$config = Config::load($root);
$fake = in_array('--fake', $argv, true);

// ── 装配：注册容器 + 插件发现 ──────────────────────────────
$kernel = new AgentKernel($config);
PluginManager::load($kernel, $root);

$ui = new ConsoleUi($config);

// 工具执行授权：ask 模式下写文件/执行命令前 Y/n 确认（fake 演示不启用）。
// 必须在 AgentLoop 构造之前注册（loop 构造时快照钩子列表）。
if (!$fake && $config->permissions() === 'ask') {
    $kernel->addHook(new ConfirmHook(
        static fn (string $tool, array $input): string => $ui->promptTool($tool, $input)
    ));
}

$client = $kernel->provider($fake ? 'fake' : $config->provider());
$loop = new AgentLoop(
    $client,
    $kernel->toolRegistry(),
    DefaultSystemPrompt::text($config->workspace()),
    $config->maxIterations(),
    $kernel->hooks() // 钩子快照：内置插件（审计）+ ConfirmHook
);

$ui->banner($fake);

// ── 会话状态 ────────────────────────────────────────────────
$store = $kernel->sessionStore();
$sessionId = $config->sessionId();
$messages = [];

if (!$fake && $config->model() === '') {
    fwrite(STDERR, "⚠ 未配置 AGENT_MODEL，请在 .env 里设置（参考 .env.example）\n");
}

$storeClass = get_class($store);
$ui->info('会话存储: ' . substr($storeClass, (int) strrpos($storeClass, '\\') + 1));
if ($store->load($sessionId) !== []) {
    $ui->info("检测到已有会话 '{$sessionId}'：/resume 恢复继续，/new 开新会话");
}

// ── 主循环 ─────────────────────────────────────────────────
while (true) {
    $line = $ui->readLine();
    if ($line === null) {
        break; // EOF (Ctrl+D)
    }
    $line = trim($line);
    if ($line === '') {
        continue;
    }

    // 斜杠命令分发（/exit 是 shell 级控制流，直接处理）
    if ($line[0] === '/') {
        $parts = preg_split('/\s+/', substr($line, 1), 2) ?: [];
        $name = strtolower(trim((string) ($parts[0] ?? '')));
        if ($name === 'exit' || $name === 'quit') {
            break;
        }
        $cmd = $kernel->command($name);
        if ($cmd === null) {
            $ui->error("未知命令 /{$name}（/help 查看可用命令）");
            continue;
        }
        try {
            $argStr = trim((string) ($parts[1] ?? ''));
            $args = $argStr === '' ? [] : (preg_split('/\s+/', $argStr) ?: []);
            $ui->info($cmd->execute($args, new CommandContext($kernel, $messages, $sessionId)));
        } catch (\Throwable $e) {
            $ui->error($e->getMessage());
        }
        continue;
    }

    // 正常任务：跑 agent 循环，成功后整段保存会话
    $snapshot = $messages;
    try {
        $loop->run($messages, $line, $ui->handleEvent(...));
        $store->save($sessionId, $messages);
        HookPipeline::fire($kernel->hooks(), 'session_saved', ['sessionId' => $sessionId]);
    } catch (\Throwable $e) {
        $messages = $snapshot; // 回滚本轮，避免历史里残留半条消息
        $ui->error($e->getMessage());
    }
}

$ui->goodbye();
