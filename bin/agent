#!/usr/bin/env php
<?php

declare(strict_types=1);

/**
 * PHP Agent 终端入口。
 *
 *   php bin/agent          正常启动（按 .env 的 provider 与插件装配）
 *   php bin/agent --fake   离线演示（不需要 API key）
 */

use PhpAgent\Agent\AgentLoop;
use PhpAgent\Agent\DefaultSystemPrompt;
use PhpAgent\Command\CommandContext;
use PhpAgent\Config;
use PhpAgent\Hook\ConfirmHook;
use PhpAgent\Hook\HookPipeline;
use PhpAgent\Kernel\AgentKernel;
use PhpAgent\Kernel\PluginManager;
use PhpAgent\Kernel\PluginScaffolder;
use PhpAgent\Kernel\ProfileRegistry;
use PhpAgent\Kernel\SessionModelRebinder;
use PhpAgent\Ui\ConsoleUi;

require __DIR__ . '/../vendor/autoload.php';

$root = dirname(__DIR__);
$config = Config::load($root);
$fake = in_array('--fake', $argv, true);

// 插件脚手架：php bin/agent --plugin:new <name>
$flagIdx = array_search('--plugin:new', $argv, true);
if ($flagIdx !== false) {
    $name = trim((string) ($argv[$flagIdx + 1] ?? ''));
    if ($name === '') {
        fwrite(STDERR, "用法: php bin/agent --plugin:new <name>（小写字母开头，含字母/数字/-/_）\n");
        exit(1);
    }
    try {
        echo PluginScaffolder::create($root, $name);
        exit(0);
    } catch (\Throwable $e) {
        fwrite(STDERR, '✗ ' . $e->getMessage() . "\n");
        exit(1);
    }
}

// ── 装配：注册容器 + 插件发现 ──────────────────────────────
$kernel = new AgentKernel($config);
PluginManager::load($kernel, $root);

$ui = new ConsoleUi($config);

// 工具执行授权：ask 模式下写文件/执行命令前 Y/n 确认（fake 演示不启用）。
// 必须在 AgentLoop 构造之前注册（loop 构造时快照钩子列表）。
if (!$fake && $config->permissions() === 'ask') {
    $kernel->addHook(new ConfirmHook(
        static fn (string $tool, array $input): string => $ui->promptTool($tool, $input),
        $kernel->toolRegistry()
    ));
}

// ── 模型目录装配：AGENT_PROFILES 多档（会话内 /model 切换）；未配置 → 单 default 档 ──
$registry = new ProfileRegistry($kernel);
if ($fake) {
    // 离线演示不解析 profiles：单 fake 档，/model 可见但无切换余地（resolve 委托 kernel fake 工厂）
    $registry->setProfiles([['id' => 'default', 'name' => 'fake', 'provider' => 'fake',
        'baseUrl' => '', 'apiKey' => '', 'models' => ['fake']]], 'default');
    $client = $kernel->provider('fake');
} else {
    $catalog = $config->profiles();
    if ($catalog === []) {
        // 单配置模式（现行为）：合成 default 档；configFor 全局兜底保证请求与直取 kernel provider 一致
        $registry->setProfiles([['id' => 'default', 'name' => $config->provider(),
            'provider' => $config->provider(), 'baseUrl' => $config->baseUrl(),
            'apiKey' => $config->apiKey(), 'models' => [$config->model() ?: '']]], 'default');
    } else {
        $registry->setProfiles($catalog, $config->defaultProfileId() ?: (string) ($catalog[0]['id'] ?? ''));
    }
    $client = $registry->resolve(null, null); // 默认档
}
$kernel->setProfileRegistry($registry);

$loop = new AgentLoop(
    $client,
    $kernel->toolRegistry(),
    DefaultSystemPrompt::text($config->workspace()),
    $config->maxIterations(),
    $kernel->hooks() // 钩子快照：内置插件（审计）+ ConfirmHook
);
$kernel->setLoop($loop);

$ui->banner($fake);

// ── 会话状态 ────────────────────────────────────────────────
$store = $kernel->sessionStore();
$sessionId = $config->sessionId();
$lastSessionId = $sessionId;
$messages = [];
$selection = null; // 当前会话的模型选择 ['profileId','model']；null = 未选择（save 传 null 保留既有 meta）

if (!$fake && $config->profiles() === [] && $config->model() === '') {
    fwrite(STDERR, "⚠ 未配置 AGENT_MODEL，请在 .env 里设置（参考 .env.example）\n");
}

$storeClass = get_class($store);
$ui->info('会话存储: ' . substr($storeClass, (int) strrpos($storeClass, '\\') + 1));
if ($store->load($sessionId) !== []) {
    $ui->info("检测到已有会话 '{$sessionId}'：/resume 恢复继续，/new 开新会话");
}

// ── 主循环 ─────────────────────────────────────────────────
while (true) {
    $line = $ui->readLine();
    if ($line === null) {
        break; // EOF (Ctrl+D)
    }
    $line = trim($line);
    if ($line === '') {
        continue;
    }

    // 斜杠命令分发（/exit 是 shell 级控制流，直接处理）
    if ($line[0] === '/') {
        $parts = preg_split('/\s+/', substr($line, 1), 2) ?: [];
        $name = strtolower(trim((string) ($parts[0] ?? '')));
        if ($name === 'exit' || $name === 'quit') {
            break;
        }
        $cmd = $kernel->command($name);
        if ($cmd === null) {
            $ui->error("未知命令 /{$name}（/help 查看可用命令）");
            continue;
        }
        try {
            $argStr = trim((string) ($parts[1] ?? ''));
            $args = $argStr === '' ? [] : (preg_split('/\s+/', $argStr) ?: []);
            $ui->info($cmd->execute($args, new CommandContext($kernel, $messages, $sessionId, $selection)));
        } catch (\Throwable $e) {
            $ui->error($e->getMessage());
        }

        // 会话切换钩子（/resume、/new 统一生效）：按新会话 meta 重绑模型——
        // 有选择 → 恢复该选择；无选择/记录档已删 → 回落默认档（与桌面「新对话 = 默认模型」一致）
        if ($sessionId !== $lastSessionId) {
            $lastSessionId = $sessionId;
            $selection = SessionModelRebinder::rebind($registry, $loop, $sessionId, $store);
            $modelDesc = $selection !== null
                ? "{$selection['profileId']} / {$selection['model']}"
                : '默认档';
            $ui->info("当前模型: {$modelDesc}");
        }
        continue;
    }

    // 正常任务：跑 agent 循环，成功后整段保存会话（含模型选择；null = 保留既有 meta）
    $snapshot = $messages;
    try {
        $loop->run($messages, $line, $ui->handleEvent(...));
        $store->save($sessionId, $messages, $selection);
        HookPipeline::fire($kernel->hooks(), 'session_saved', ['sessionId' => $sessionId]);
    } catch (\Throwable $e) {
        $messages = $snapshot; // 回滚本轮，避免历史里残留半条消息
        $ui->error($e->getMessage());
    }
}

$ui->goodbye();
