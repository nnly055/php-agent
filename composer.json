{
    "name": "php-agent/php-agent",
    "description": "PHP 终端/桌面 coding agent MVP：LLM 流式对话 + 工具调用 + 本地 SSE 服务",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "react/http": "^1.9",
        "react/async": "^4.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": { "PhpAgent\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "PhpAgent\\Tests\\": "tests/" }
    },
    "scripts": {
        "test": "phpunit",
        "agent": "php bin/agent",
        "server": "php bin/server"
    },
    "config": {
        "sort-packages": true
    }
}
