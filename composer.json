{
    "name": "nnly055/php-agent",
    "description": "PHP 终端/桌面 coding agent：LLM 流式对话 + 工具调用 + 插件化持久化 + 本地 SSE 服务",
    "type": "project",
    "license": "MIT",
    "keywords": ["agent", "llm", "coding-agent", "php", "cli", "tool-calling", "deepseek", "openai", "anthropic"],
    "require": {
        "php": ">=8.1",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "react/http": "^1.9",
        "react/async": "^4.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": { "PhpAgent\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": {
            "PhpAgent\\Tests\\": "tests/",
            "PhpAgent\\TestVendor\\": "tests/fixtures/composer-test/lib/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "agent": "php bin/agent",
        "server": "php bin/server"
    },
    "config": {
        "sort-packages": true
    }
}
