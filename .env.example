# ══════════════════════════════════════════════════════════
#  PHP Agent 配置（复制为 .env 后修改）
# ══════════════════════════════════════════════════════════

# provider: openai（兼容协议）| anthropic | fake（离线演示）
AGENT_PROVIDER=openai

# API Key（必填，fake 模式除外）
AGENT_API_KEY=

# ── 下面任选一个 preset 取消注释 ──────────────────────────

# ── 智谱 GLM ──
# AGENT_PROVIDER=openai
# AGENT_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# AGENT_MODEL=glm-4.6

# ── DeepSeek ──
# AGENT_PROVIDER=openai
# AGENT_BASE_URL=https://api.deepseek.com/v1
# AGENT_MODEL=deepseek-chat

# ── Kimi (月之暗面) ──
# AGENT_PROVIDER=openai
# AGENT_BASE_URL=https://api.moonshot.cn/v1
# AGENT_MODEL=kimi-k2-0905-preview

# ── OpenAI ──
# AGENT_PROVIDER=openai
# AGENT_BASE_URL=https://api.openai.com/v1
# AGENT_MODEL=gpt-4o

# ── Anthropic (原生协议) ──
# AGENT_PROVIDER=anthropic
# AGENT_BASE_URL=https://api.anthropic.com
# AGENT_MODEL=claude-sonnet-4-5

# ───────────────────────────────────────────────────────────

# ── 会话持久化（插件化，一行切换）─────────────────────────
# memory   = 不持久化（重启即丢）
# json     = 默认，~/.php-agent/sessions/<id>.json，人可读
# sqlite3  = 单文件 db（需 ext-sqlite3）
# redis    = 多进程/常驻场景（需 ext-redis + Redis 服务）
AGENT_SESSION_STORE=json

# CLI 默认会话 id
AGENT_SESSION_ID=default

# 会话存储目录（json/sqlite3 用，默认 ~/.php-agent/sessions）
# AGENT_SESSION_DIR=/path/to/dir

# ── 插件 ──────────────────────────────────────────────────
# off = 只加载内置；逗号列表 = 内置 + 指定 name 的项目插件；留空 = 全部加载
# AGENT_PLUGINS=off

# ── Redis（AGENT_SESSION_STORE=redis 时生效）──────────────
# AGENT_REDIS_HOST=127.0.0.1
# AGENT_REDIS_PORT=6379
# AGENT_REDIS_DB=0
# AGENT_REDIS_PASSWORD=

# 单次回复最大 token
AGENT_MAX_TOKENS=8192

# 工具调用最大轮数（熔断保护）
AGENT_MAX_ITERATIONS=25

# 工具沙箱目录（默认 = 启动 agent 时的当前目录）
# AGENT_WORKSPACE=/Users/mac/project

# 本地 SSE 服务端口
AGENT_SERVER_PORT=8091
